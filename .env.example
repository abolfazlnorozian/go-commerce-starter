# Server
PORT=8000
CORS_DOMAIN=http://localhost:3000
BASE_URL=http://localhost:8000

# MongoDB
# Local: mongodb://localhost:27017
# Docker Compose: mongodb://mongo:27017
MONGO_URL=mongodb://localhost:27017
DBNAME=shop

# Auth (generate a long random string for production)
SECRET_KEY=change-me-to-a-long-random-secret

# Payments (Zarinpal merchant ID — leave empty for local exploration)
ZARINPAL_MERCHANT_ID=

# SMS (IPPanel) — required only if you enable OTP / notification SMS
# Create patterns in your IPPanel panel, then paste the codes below.
IPPANEL_API_KEY=your_ippanel_api_key_here
# Pattern SMS originator (code default if unset: +983000505)
IPPANEL_ORIGINATOR=+983000505
# Broadcast / webservice sender (code default if unset: +98Clubs)
IPPANEL_SMS_SENDER=+98Clubs
# OTP on GET /api/users/auth/smsverification  → helpers.SendSms
IPPANEL_PATTERN_VERIFY=your_verify_pattern_code
# After Zarinpal payment verify → helpers.BackPaymentSendSms
IPPANEL_PATTERN_PAYMENT=your_payment_pattern_code
# Admin sets order status "pending" → helpers.SendSmstoCustomerForReadyProduct
IPPANEL_PATTERN_READY_PRODUCT=your_ready_product_pattern_code
# Admin sets order status "done" → helpers.SendSmstoCustomerForSendProduct
IPPANEL_PATTERN_SEND_PRODUCT=your_send_product_pattern_code
# Notify admins on successful payment → helpers.SendSmstoAdmin
IPPANEL_PATTERN_ADMIN=your_admin_notify_pattern_code

# Comma-separated admin phone numbers notified on successful payments
ADMINS_PHONES=

# Image resize max dimension for /uploads WebP conversion (upper bound 16383)
IMAGE_QUALITY=1200

# Set to "true" only when you intentionally want carts wiped on startup
MIGRATION_DELETE_CART=false
